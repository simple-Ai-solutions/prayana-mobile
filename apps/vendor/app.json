{
  "expo": {
    "name": "Partners Hub",
    "slug": "prayana-business",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "prayanabiz",
    "owner": "srikanthvaijapur",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/REPLACE_WITH_VENDOR_PROJECT_ID",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prayanaai.business",
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:business.prayanaai.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of your activities, listings, and KYC documents.",
        "NSPhotoLibraryUsageDescription": "Upload activity images and business documents from your library.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "tel",
          "mailto",
          "whatsapp"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "prayanabiz"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.926782873134-ljojer8isfftfsbtbg93aiskel9p5t14"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.prayanaai.business",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "ACCESS_BACKGROUND_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "business.prayanaai.com",
              "pathPrefix": "/app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "autoVerify": true
        }
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-secure-store",
      "expo-image-picker",
      "expo-document-picker",
      "@sentry/react-native/expo"
    ],
    "extra": {
      "router": {
        "origin": false,
        "root": "./src/app"
      },
      "eas": {
        "projectId": "7443b2d6-fa3b-4d9a-b53d-b7439adcc50d"
      }
    }
  }
}
